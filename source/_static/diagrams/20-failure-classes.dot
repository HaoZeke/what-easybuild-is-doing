digraph g_20_failure_classes {
  graph [rankdir=TB, bgcolor="transparent", pad="0.2", nodesep="0.35", ranksep="0.55",
         fontname="Inter,Helvetica,sans-serif"];
  node [shape=box, style="rounded,filled", fillcolor="#f7f6f3", color="#1a1917",
        fontname="Inter,Helvetica,sans-serif", fontsize=11, penwidth=1.2];
  edge [color="#1a1917", arrowsize=0.7, penwidth=1.1];
  log [label="easybuild.log"];
  fe [label="fetch"];
  cf [label="configure"];
  sa [label="sanity"];
  pin [label="the pin that missed"];
  log -> fe -> pin;
  log -> cf -> pin;
  log -> sa -> pin;
}
