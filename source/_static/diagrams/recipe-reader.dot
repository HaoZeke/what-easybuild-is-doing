digraph recipe_reader {
  graph [rankdir=LR, bgcolor="transparent", pad="0.2", nodesep="0.4", ranksep="0.55",
         fontname="Inter,Helvetica,sans-serif"];
  node [shape=box, style="rounded,filled", fillcolor="#f7f6f3", color="#1a1917",
        fontname="Inter,Helvetica,sans-serif", fontsize=11, penwidth=1.2];
  edge [color="#1a1917", arrowsize=0.7, penwidth=1.1];

  eb   [label=".eb file"];
  eval [label="evaluate"];
  block [label="easyblock"];
  tc   [label="toolchain"];
  mod  [label="module"];

  eb -> eval -> block -> tc -> mod;
}
