digraph reframe_reader {
  graph [rankdir=LR, bgcolor="transparent", pad="0.2", nodesep="0.35", ranksep="0.45",
         fontname="Inter,Helvetica,sans-serif"];
  node [shape=box, style="rounded,filled", fillcolor="#f7f6f3", color="#1a1917",
        fontname="Inter,Helvetica,sans-serif", fontsize=10, penwidth=1.2];
  edge [color="#1a1917", arrowsize=0.65, penwidth=1.1];

  setup   [label="setup"];
  compile [label="compile"];
  run     [label="run"];
  sanity  [label="sanity"];
  perf    [label="performance"];
  clean   [label="cleanup"];

  setup -> compile -> run -> sanity -> perf -> clean;
}
