  "derived": [
    {
      "key": "name",
      "rule": "field:name"
    },
    {
      "key": "version",
      "rule": "field:version"
    },
    {
      "key": "versionsuffix",
      "rule": "field:versionsuffix"
    },
    {
      "key": "toolchain_name",
      "rule": "field:toolchain_name"
    },
    {
      "key": "toolchain_version",
      "rule": "field:toolchain_version"
    },
    {
      "key": "namelower",
      "rule": "lower:name"
    },
    {
      "key": "nameletter",
      "rule": "first_char:name"
    },
    {
      "key": "nameletterlower",
      "rule": "first_char_lower:name"
    },
    {
      "key": "github_account",
      "rule": "lower:name"
    },
    {
      "key": "bitbucket_account",
      "rule": "lower:name"
    },
    {
      "key": "version_major",
      "rule": "part:0"
    },
    {
      "key": "version_minor",
      "rule": "part:1"
    },
    {
      "key": "version_patch",
      "rule": "part:2"
    },
    {
      "key": "version_major_minor",
      "rule": "join:0-1"
    },
    {
      "key": "version_minor_patch",
      "rule": "join:1-2"
    },
    {
      "key": "version_major_minor_patch",
      "rule": "join:0-2"
    },
    {
      "key": "arch",
      "rule": "host_arch"
    },
    {
      "key": "pyver",
      "rule": "field:version;only_if_name:Python"
    },
    {
      "key": "pymajver",
      "rule": "part:0;only_if_name:Python"
    },
    {
      "key": "pyminver",
      "rule": "part:1;only_if_name:Python"
    },
    {
      "key": "pyshortver",
      "rule": "join:0-1;only_if_name:Python"
    }
  ]
